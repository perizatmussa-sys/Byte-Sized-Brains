# Секретная ссылка организаторов, вставляется ТОЛЬКО в локальный .env
CQA_API_URL=

# Бесплатные провайдеры. Можно добавить оба или только один.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# https://aistudio.google.com/api-keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# По умолчанию запрещена отправка 5 реальных звонков стороннему AI.
CQA_ALLOW_REAL_CALLS=false
